# Application
APP_NAME=Enterprise AI Service Desk
APP_VERSION=1.0.0
APP_DESCRIPTION=Enterprise AI Service Desk powered by Agentic AI
LOG_LEVEL=INFO

# CORS (comma-separated origins for the Vite dashboard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence (used in later phases)
DATABASE_URL=sqlite:///./database/servicedesk.db

# RAG / ChromaDB (used in later phases)
CHROMA_PATH=../database/chroma_db
KB_DIR=../knowledgebase

# Ollama (used in later phases)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# LangSmith (used in later phases)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-servicedesk

# Azure (used in later phases)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
